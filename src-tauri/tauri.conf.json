{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "飞牛影视",
  "version": "2.6.1",
  "identifier": "com.qiaokes.fntv",
  "build": {
    "frontendDist": "../resource/login",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:server & npm run build:inject && npm run build:proxy:tauri:win",
    "beforeBuildCommand": "npm run build:inject && npm run build:proxy:tauri:win"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/proxy"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "desktopTemplate": null
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
